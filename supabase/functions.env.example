# Copy to supabase/.env.local for local function serving. Never commit the copy.
OPENAI_API_KEY=sk-project-...
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_LIMIT=30
APP_ORIGINS=http://localhost:5173,https://YOUR_USER.github.io
APP_URL=http://localhost:5173/

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=replace-with-a-long-random-value
